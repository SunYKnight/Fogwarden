{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DM and player windows: events, closing the own window, reading the storage areas",
  "windows": ["dm", "player"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "allow-storage-roots",
    "allow-storage-read-text",
    "allow-storage-read-bytes",
    "allow-storage-list",
    "allow-storage-exists",
    "allow-storage-asset-path"
  ]
}
