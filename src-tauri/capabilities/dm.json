{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dm",
  "description": "DM window only: player window placement, native dialogs, app updates, writes, files outside the storage areas, version history, LAN server, relay deployment",
  "windows": ["dm"],
  "permissions": [
    "core:window:allow-available-monitors",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart",
    "allow-storage-set-data-root",
    "allow-storage-write-text",
    "allow-storage-write-bytes",
    "allow-storage-remove",
    "allow-storage-copy",
    "allow-storage-copy-data-root",
    "allow-storage-open-data-root",
    "allow-storage-list-folder",
    "allow-storage-import-file",
    "allow-storage-read-file-text",
    "allow-storage-is-file",
    "allow-storage-read-file-bytes",
    "allow-storage-write-file-bytes",
    "allow-history-list",
    "allow-history-prune",
    "allow-history-clean",
    "allow-history-restore",
    "allow-history-open-folder",
    "allow-lan-start",
    "allow-lan-set-links",
    "allow-lan-stop",
    "allow-lan-status",
    "allow-lan-player-upload",
    "allow-lan-delete-player-upload",
    "allow-frontend-file",
    "allow-deploy-write-files",
    "allow-deploy-host-key",
    "allow-deploy-run"
  ]
}
